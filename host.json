{
  "version": "2.0",
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "queues": {
      "messageEncoding": "base64",
      "batchSize": 1,
      "newBatchThreshold": 1,
      "maxDequeueCount": 5,
      "visibilityTimeout": "00:15:00"
    }
  }
}
